  pages:
  - cutsceneImage: {fileID: 7720211684664866777, guid: f1c114f3e8242ee4abc35ab6e5a5da13,
      type: 3}
    storyText: "\uB9C8\uC871 \uB140\uC11D\uB4E4\uC774 \uC790\uAFB8 \uC6B0\uB9AC \uB9C8\uC744\uC5D0
      \uCCD0\uB4E4\uC5B4\uC640\uC11C \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC744 \uB2E4\uCE58\uAC8C
      \uD588\uB2E4!\n\uC6B0\uB9AC \uC5C4\uB9C8\uB3C4 \uC544\uBE60\uB3C4 \uB0B4\uAC00
      \uC544\uC8FC \uC5B4\uB9B4\uB54C \uB2E4\uCCD0\uC11C \uB098\uB97C \uB370\uB9AC\uB7EC
      \uC624\uC9C0 \uBABB\uD55C\uB2E4. \uC5C4\uB9C8 \uC544\uBE60\uAC00 \uBCF4\uACE0\uC2F6\uB2E4."
  - cutsceneImage: {fileID: -7773272851656168963, guid: 23bd6b89e5842a3459bea11f16b47b78,
      type: 3}
    storyText: "\uC218\uB140\uB2D8\uC740 \"\uB85C\uC9C4\uC774\uB294 \uB9C8\uC871\uC744
      \uC6A9\uC11C\uD574\uC57C \uD55C\uB2E4\"\uACE0 \uD558\uC168\uB294\uB370 \uC798
      \uBAA8\uB974\uACA0\uB2E4.\n\uADF8\uB0E5 \uD63C\uC790 \uC9C0\uB0B4\uB294 \uC9D1\uC740
      \uC544\uC8FC \uC870\uAE08 \uBB34\uC11C\uC6CC\uC11C \uC544\uBE60 \uBAA8\uC790\uB97C
      \uC548\uACE0 \uC794\uB2E4."
  - cutsceneImage: {fileID: -616660088389119349, guid: d4b6aaf0cab11c044b7cfe5e9af7e27e,
      type: 3}
    storyText: "\uC624\uB298 \uAD50\uD68C\uC5D0\uC11C \uC77D\uC740 \uCC45\uC5D0 \uC18C\uC6D0\uC744
      \uC774\uB904\uC8FC\uB294 \uB3D9\uC0C1\uC744 \uCC3E\uC558\uB2E4.\n\uB3D9\uC0C1\uC744
      \uCC3E\uC544\uC11C \uC5C4\uB9C8\uB791 \uC544\uBE60\uAC00 \uB3CC\uC544\uC624\uAC8C
      \uD574\uB2EC\uB77C\uACE0 \uC18C\uC6D0\uC744 \uBE4C \uAC83\uC774\uB2E4.\n\uC218\uB140\uB2D8\uC774
      \uC54C\uAE30 \uC804\uC5D0 \uBC14\uB85C \uCD9C\uBC1C\uD560 \uAC83\uC774\uB2E4"
